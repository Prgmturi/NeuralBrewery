# =============================================================================
# Application
# =============================================================================
APP_NAME=neuralbrewery
# APP_VERSION is read from the installed package; set it only to override
# Staging and production: startup fails while development values like the
# ones in this file remain, and the error lists them
# (core/config/production.py)
APP_ENVIRONMENT=development
APP_DEBUG=true
APP_LOG_LEVEL=INFO

# =============================================================================
# Server
# =============================================================================
# Read by python -m neuralbrewery.serve, the Docker image's command, and by
# its healthcheck. The uvicorn command of the README (development) takes its
# own --host and --port. compose.yaml publishes the API on SERVER_PORT.
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
# Only 1: the plant lives in the process of the API, one plant per process
SERVER_WORKERS=1
# Seconds open requests get when the process is asked to stop; keep it
# below the stop timeout of the container (docker stop waits 10 seconds)
SERVER_TIMEOUT_GRACEFUL_SHUTDOWN=5
# The proxies whose X-Forwarded-For sets the client address in the logs, as a
# JSON list of addresses or networks. Production refuses "*".
SERVER_FORWARDED_ALLOW_IPS=["127.0.0.1"]
# The pages allowed to call the API from a browser, and the origins the MCP
# server accepts.
SERVER_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
# Largest request body in bytes; a larger one gets 413. Default 64 KiB.
SERVER_MAX_BODY_SIZE=65536

# =============================================================================
# Database
# =============================================================================
# The db service of compose.yaml, seen from the host. Compose reads the port,
# the name, the user and the password from this file too, so the database it
# creates and the app agree. 127.0.0.1, where compose publishes it: on Windows
# localhost is ::1 first, and each new connection waited about 2 s.
DATABASE_DRIVER=postgresql+asyncpg
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5433
DATABASE_NAME=appbase
DATABASE_USER=appbase
DATABASE_PASSWORD=appbase_secret_change_me
# At least 1 connection and 0 or more overflow: SQLAlchemy reads 0 and -1
# as "no limit", so the app refuses them
DATABASE_POOL_SIZE=5
DATABASE_POOL_MAX_OVERFLOW=10
# Seconds to open a connection, and seconds a query may run. A connection not
# opened in time answers 503, retry later; a slower query answers 500 and
# Postgres stops it. Migrations have no limit.
DATABASE_CONNECT_TIMEOUT=5
DATABASE_COMMAND_TIMEOUT=30
DATABASE_ECHO=false

# Integration tests only (uv run pytest -m integration, docs/development.md):
# the same server, another database. The name must end in _test,
# because the tests create and drop tables in it.
TEST_DATABASE_HOST=127.0.0.1
TEST_DATABASE_PORT=5433
TEST_DATABASE_NAME=appbase_test
TEST_DATABASE_USER=appbase
TEST_DATABASE_PASSWORD=appbase_secret_change_me


# =============================================================================
# Claude: the model of the agents
# =============================================================================
# The Anthropic API key: the evals need it (uv run pytest -m eval), the tests
# do not. Keep it in .env only, never in the repo. Empty: the agents cannot run.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
# Tokens per call, thinking included, and how much the model thinks
CLAUDE_MAX_TOKENS=16000
CLAUDE_EFFORT=high


# =============================================================================
# The provider of the agents
# =============================================================================
# claude, the default, or openai_compat: an API that copies OpenAI's, below.
# Only the key of the chosen provider counts. The evals run on it too.
AGENT_PROVIDER=claude
# Gemini on its free tier: a key from Google AI Studio, in .env only, never
# in the repo. Groq or a local model take another address, model and key.
OPENAI_COMPAT_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
OPENAI_COMPAT_MODEL=gemini-3.5-flash-lite
OPENAI_COMPAT_API_KEY=


# =============================================================================
# The plant, in the process of the API until M2
# =============================================================================
# The named start (brew_day or fermentation) and its seed. A restart builds a
# new plant from them: what happened to the old one is gone.
PLANT_START=brew_day
PLANT_SEED=42
# The routes that move the simulated time and inject faults, for the demo.
# Staging and production refuse true.
PLANT_SIMULATION_CONTROL=true


# =============================================================================
# The manuals of the components (data/manuals/text/)
# =============================================================================
# The plant agent searches them (search_manuals: BM25, in process, no
# network) for the meaning of a fault code or a signal, and cites manual and
# page. On for the stack, here and in compose; false gives the agent the
# tools it had before. On, the app does not start without the text; the
# folder is relative to where the app starts (the root of the repository,
# or /app in the image).
MANUALS_ENABLED=true
MANUALS_FOLDER=data/manuals/text


# =============================================================================
# Approvals
# =============================================================================
# Whoever sends this token in the X-Approval-Token header approves or rejects
# a proposal. Empty: nobody can. This value is public: staging and production
# refuse it.
APPROVAL_TOKEN=brewer-dev-token


# =============================================================================
# The brewer's dashboard (src/neuralbrewery/dashboard/)
# =============================================================================
# Read by the dashboard run on the host:
#   uv run streamlit run src/neuralbrewery/dashboard/app.py
# compose.yaml sets both for its dashboard service. The token is the one the
# API expects in APPROVAL_TOKEN: the dashboard sends it to propose, approve
# and reject, and never shows it.
DASHBOARD_API_URL=http://localhost:8000
DASHBOARD_APPROVAL_TOKEN=brewer-dev-token
